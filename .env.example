SPORTS_EDGE_ENV=development
SPORTS_EDGE_TIMEZONE=Asia/Taipei
SPORTS_EDGE_LOG_LEVEL=INFO
# Optional explicit root override. Leave empty in normal portable usage.
SPORTS_EDGE_ROOT=

# Optional research-only The Odds API credential. Never commit the real value.
# Historical odds require an eligible paid plan; current odds/scores can use free plans.
SPORTS_EDGE_THE_ODDS_API_KEY=
# Keep a reserve below the provider's free monthly quota.
SPORTS_EDGE_THE_ODDS_API_MONTHLY_CREDIT_BUDGET=450
SPORTS_EDGE_THE_ODDS_API_REGION=us

# Optional Backblaze B2 zero-cost checkpoint backend. Never commit real key values.
# Data key: bucket + prefix scoped; minimal file/read-replication capabilities only.
SPORTS_EDGE_BACKBLAZE_B2_KEY_ID=
SPORTS_EDGE_BACKBLAZE_B2_APPLICATION_KEY=
# Pointer key: capability-scoped to listBuckets + writeBuckets only. Backblaze does not
# allow writeBuckets on a bucket-restricted key, so this must be a separate key.
SPORTS_EDGE_BACKBLAZE_B2_POINTER_KEY_ID=
SPORTS_EDGE_BACKBLAZE_B2_POINTER_APPLICATION_KEY=
SPORTS_EDGE_BACKBLAZE_B2_BUCKET_ID=
SPORTS_EDGE_BACKBLAZE_B2_BUCKET_NAME=
SPORTS_EDGE_BACKBLAZE_B2_NAME_PREFIX=sports-edge-ai/
# Manual account evidence. Keep false until directly verified in the Backblaze console.
SPORTS_EDGE_BACKBLAZE_B2_NO_PAYMENT_METHOD_CONFIRMED=false
SPORTS_EDGE_BACKBLAZE_B2_ZERO_DOLLAR_STORAGE_CAP_CONFIRMED=false
SPORTS_EDGE_BACKBLAZE_B2_ZERO_DOLLAR_DOWNLOAD_CAP_CONFIRMED=false
SPORTS_EDGE_BACKBLAZE_B2_TRANSACTION_CAPS_CONFIRMED=false
SPORTS_EDGE_FORWARD_CURRENT_MIN_INTERVAL_MINUTES=180
SPORTS_EDGE_FORWARD_SCORES_MIN_INTERVAL_MINUTES=720
SPORTS_EDGE_FORWARD_SCORES_DAYS_FROM=3
SPORTS_EDGE_OPERATIONAL_COLLECTION_STALE_AFTER_MINUTES=150
SPORTS_EDGE_OPERATIONAL_RESEARCH_STALE_AFTER_MINUTES=150
SPORTS_EDGE_OPERATIONAL_BUDGET_WARNING_FRACTION=0.8
